# ============================================================
# NEXO — modelo de configuração
# Jeito fácil: rode scripts\CONFIGURAR.bat (ele cria o .env e testa tudo).
# À mão: copie este arquivo para ".env" (na raiz do projeto) e preencha.
# NÃO envie o .env para o GitHub: ele contém senhas. Compartilhe só por canal privado.
# ============================================================

# ---- Aplicação ----
# Endereço usado nos links dos e-mails (confirmação e recuperação de senha)
APP_URL_BASE=http://127.0.0.1:5000

# ---- Banco MySQL (Aiven) ----
# console.aiven.io → serviço MySQL → Overview → Connection information
# Deixe DB_HOST vazio para usar o modo local (CSV + SQLite).
DB_HOST=
# O "Port" do Aiven (ex.: 12345) — NÃO é 3306
DB_PORT=
DB_USER=avnadmin
DB_PASSWORD=
# O script de migração cria o banco "nexo" (o Aiven já vem com "defaultdb")
DB_NAME=nexo
# CA certificate (Overview → CA certificate → Download), salvo nesta pasta
DB_SSL_CA=banco/dados/ca.pem

# ---- E-mail (confirmação de cadastro e recuperação de senha) ----
# Gmail: crie uma "senha de app" em https://myaccount.google.com/apppasswords
# Outlook/Hotmail: SMTP_HOST=smtp-mail.outlook.com, SMTP_PORT=587
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
# starttls (porta 587) | ssl (porta 465) | nenhuma
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=NEXO <seu.email@gmail.com>
